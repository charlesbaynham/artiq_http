http://, https://localhost {
    handle /api/* {
        reverse_proxy {$API_URL:http://backend:8000}
    }
    handle /docs* {
        reverse_proxy {$API_URL:http://backend:8000}
    }
    handle /openapi.json {
        reverse_proxy {$API_URL:http://backend:8000}
    }
    handle /mcp* {
        reverse_proxy {$MCP_URL:http://mcp:8001}
    }
    handle {
        root * /srv/result
        encode gzip zstd
        try_files {path} /index.html
        file_server
    }
}
