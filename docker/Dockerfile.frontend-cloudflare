# Dockerfile for Caddy with Cloudflare DNS module
# Builds a custom Caddy binary with Cloudflare DNS-01 challenge support

# Stage 1: Build Caddy with Cloudflare module
FROM caddy:2-builder AS caddy-builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare

# Stage 2: Build frontend
FROM node:18 AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 3: Final image with custom Caddy
FROM caddy:2-alpine

# Copy custom Caddy binary with Cloudflare module
COPY --from=caddy-builder /usr/bin/caddy /usr/bin/caddy

# Copy built frontend
COPY --from=frontend-builder /app/frontend/dist /srv/result

# Copy Cloudflare-enabled Caddyfile
COPY docker/Caddyfile.cloudflare /etc/caddy/Caddyfile

EXPOSE 80 443

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
