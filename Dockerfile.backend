# Stage 1: Build with UV
FROM python:3.11 AS builder

WORKDIR /app

# Install UV
RUN pip install --no-cache-dir uv

# Copy dependency files
COPY pyproject.toml uv.lock ./
COPY VERSION.json ./
COPY README.rst ./

# Install dependencies (without dev extras) into project venv
RUN uv sync --no-dev --no-install-project

# Copy application code
COPY artiq_http/ ./artiq_http/

# Install the application itself
RUN uv sync --no-dev

# Stage 2: Runtime
FROM python:3.11-slim

WORKDIR /app

# Copy virtualenv and application from builder
COPY --from=builder /app/.venv .venv
COPY --from=builder /app/artiq_http artiq_http
COPY --from=builder /app/VERSION.json VERSION.json

# Set PATH to use virtualenv
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

CMD ["aqctl_artiq_http"]
