{
  "name": "artiq-http",
  "version": "0.0.1",
  "scripts": {
    "install": "cd frontend && npm install",
    "frontend": "cd frontend && npm start",
    "backend": "poetry run uvicorn artiq_http.main:fastapi_app --reload",
    "dev": "concurrently -k \"npm run frontend\" \"npm run backend\"",
    "build": "(rm -r artiq_http/static || true) && cd frontend && npm run build && mv dist ../artiq_http/static",
    "clean": "git clean -xdf --exclude venv --exclude node_modules --exclude .env",
    "serve": "poetry run aqctl_artiq_http"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
