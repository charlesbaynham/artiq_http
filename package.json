{
  "name": "artiq-http",
  "version": "0.0.1",
  "scripts": {
    "install": "cd frontend && npm install",
    "frontend": "cd frontend && npm start",
    "backend": "poetry run uvicorn artiq_http.main:fastapi_app",
    "build": "(rm -r artiq_http/static || true) && cd frontend && npm run build && mv dist ../artiq_http/static",
    "clean": "git clean -xdf --exclude venv --exclude node_modules --exclude .env",
  }
}
