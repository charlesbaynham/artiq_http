# ARTIQ HTTP Testing Environment Configuration
# This file demonstrates configuration for local testing with the test-artiq stack
#
# Usage:
#   1. Copy this file to .env:
#      cp env.testing .env
#
#   2. Build and load the local ARTIQ test image:
#      cd test-artiq
#      nix build .#docker --accept-flake-config
#      docker load < result
#      cd ..
#
#   3. Start the local testing environment:
#      docker compose -f docker/compose.yml -f docker/compose.localtesting.yml up
#
# The docker/compose.localtesting.yml file will override ARTIQ_HTTP_HOST to point to
# the artiq-test-master container, so the settings below are for reference.

# ARTIQ Master Connection Settings
# When using docker/compose.localtesting.yml, these are automatically set to connect
# to the artiq-test-master container
ARTIQ_HTTP_HOST=artiq-test-master
ARTIQ_HTTP_PORT_NOTIFIERS=3250
ARTIQ_HTTP_PORT_CLIENTS=3251
ARTIQ_HTTP_PORT_BROADCAST=1067

# Logging
ARTIQ_HTTP_LOG_LEVEL=DEBUG

# ARTIQ Compatibility
ARTIQ_HTTP_OLD_ARTIQ_SUPPORT=false

# Compose File Configuration
# Use the local testing setup with the test-artiq stack
COMPOSE_FILE=docker/compose.yml:docker/compose.localtesting.yml
