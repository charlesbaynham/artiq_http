{"openapi": "3.1.0", "info": {"title": "FastAPI", "version": "0.1.0"}, "paths": {"/api/": {"get": {"summary": "Root", "operationId": "root_api__get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}}}}, "/api/schedule": {"get": {"summary": "Get Schedule", "operationId": "get_schedule_api_schedule_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/ScheduleItem"}, "title": "Response Get Schedule Api Schedule Get"}}}}}}, "post": {"summary": "Submit Experiment", "operationId": "submit_experiment_api_schedule_post", "parameters": [{"name": "pipeline", "in": "query", "required": false, "schema": {"type": "string", "default": "main", "title": "Pipeline"}}, {"name": "priority", "in": "query", "required": false, "schema": {"type": "integer", "default": 0, "title": "Priority"}}, {"name": "flush", "in": "query", "required": false, "schema": {"type": "boolean", "default": false, "title": "Flush"}}, {"name": "due_date", "in": "query", "required": false, "schema": {"type": "number", "title": "Due Date"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExpID"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/devices": {"get": {"summary": "Get Devices", "description": "Get the current device_db\n\nReturns:\n    dict: ARTIQ Device_DB", "operationId": "get_devices_api_devices_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Get Devices Api Devices Get"}}}}}}}, "/api/datasets": {"get": {"summary": "Get Datasets", "description": "Get all existing ARTIQ datasets\n\nThis method might return a large output\n\nReturns:\n    dict: All broadcasted ARTIQ datasets", "operationId": "get_datasets_api_datasets_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}}}}, "/api/datasets/names": {"get": {"summary": "Get Dataset Names", "description": "Get list of all dataset names (keys only)\n\nReturns a lightweight list of dataset names without their values,\nenabling efficient browsing and searching.\n\nReturns:\n    dict: {\"names\": [\"dataset1\", \"dataset2\", ...]}", "operationId": "get_dataset_names_api_datasets_names_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}}}}, "/api/datasets/values": {"get": {"summary": "Get Dataset Values", "description": "Get values for specific datasets\n\nArgs:\n    names: Comma-separated list of dataset names to fetch\n\nReturns:\n    dict: Requested datasets with their values", "operationId": "get_dataset_values_api_datasets_values_get", "parameters": [{"name": "names", "in": "query", "required": true, "schema": {"type": "string", "title": "Names"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/health": {"get": {"summary": "Get Health", "description": "Get backend health and ARTIQ connection status\n\nReturns:\n    dict: Health status including ARTIQ connection state", "operationId": "get_health_api_health_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}}}}, "/api/cancel": {"post": {"summary": "Cancel Experiment", "description": "Cancel a running experiment\n\nArgs:\n    rid (int): RID of the experiment to cancel\n    force (bool): If True, forcibly close the experiment instead of requesting closure", "operationId": "cancel_experiment_api_cancel_post", "parameters": [{"name": "rid", "in": "query", "required": true, "schema": {"type": "integer", "title": "Rid"}}, {"name": "force", "in": "query", "required": false, "schema": {"type": "boolean", "default": false, "title": "Force"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/explist": {"get": {"summary": "Get Explist", "operationId": "get_explist_api_explist_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExperimentList"}}}}}}}, "/api/schedule/{rid}": {"get": {"summary": "Get Schedule Item", "operationId": "get_schedule_item_api_schedule__rid__get", "parameters": [{"name": "rid", "in": "path", "required": true, "schema": {"type": "integer", "title": "Rid"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScheduleItem"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/explist/search": {"get": {"summary": "Search Explist", "operationId": "search_explist_api_explist_search_get", "parameters": [{"name": "q", "in": "query", "required": false, "schema": {"type": "string", "default": "", "title": "Q"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExperimentList"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/explist/{file}/{class_name}/defaults": {"get": {"su