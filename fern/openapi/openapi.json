scription": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitAndWaitResult"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"ExpID": {"properties": {"log_level": {"type": "integer", "title": "Log Level", "default": 30}, "file": {"type": "string", "title": "File"}, "class_name": {"type": "string", "title": "Class Name"}, "arguments": {"anyOf": [{"additionalProperties": true, "type": "object"}, {"type": "null"}], "title": "Arguments"}, "repo_rev": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Repo Rev"}}, "type": "object", "required": ["file", "class_name", "arguments", "repo_rev"], "title": "ExpID"}, "ExperimentDefaults": {"properties": {"file": {"type": "string", "title": "File"}, "class_name": {"type": "string", "title": "Class Name"}, "arguments": {"additionalProperties": true, "type": "object", "title": "Arguments"}}, "type": "object", "required": ["file", "class_name", "arguments"], "title": "ExperimentDefaults"}, "ExperimentEntry": {"properties": {"name": {"type": "string", "title": "Name"}, "file": {"type": "string", "title": "File"}, "class_name": {"type": "string", "title": "Class Name"}, "arginfo": {"additionalProperties": true, "type": "object", "title": "Arginfo"}, "argument_ui": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Argument Ui"}, "scheduler_defaults": {"additionalProperties": true, "type": "object", "title": "Scheduler Defaults"}}, "type": "object", "required": ["name", "file", "class_name", "arginfo", "argument_ui", "scheduler_defaults"], "title": "ExperimentEntry"}, "ExperimentList": {"properties": {"current_rev": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Current Rev"}, "scanning": {"type": "boolean", "title": "Scanning"}, "experiments": {"items": {"$ref": "#/components/schemas/ExperimentEntry"}, "type": "array", "title": "Experiments", "default": []}}, "type": "object", "required": ["current_rev", "scanning"], "title": "ExperimentList"}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "ScheduleItem": {"properties": {"pipeline": {"type": "string", "title": "Pipeline"}, "priority": {"type": "integer", "title": "Priority"}, "due_date": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Due Date"}, "flush": {"type": "boolean", "title": "Flush"}, "status": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Status"}, "repo_msg": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Repo Msg"}, "expid": {"$ref": "#/components/schemas/ExpID"}}, "type": "object", "required": ["pipeline", "priority", "due_date", "flush", "status", "repo_msg", "expid"], "title": "ScheduleItem"}, "SubmitAndWaitResult": {"properties": {"rid": {"type": "integer", "title": "Rid"}, "status": {"type": "string", "title": "Status"}, "timed_out": {"type": "boolean", "title": "Timed Out"}}, "type": "object", "required": ["rid", "status", "timed_out"], "title": "SubmitAndWaitResult"}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}
