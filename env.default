# Uncomment to enable watchtower:
# COMPOSE_FILE=docker/compose.yml:docker/compose.watchtower.yml

# ARTIQ HTTP Configuration
# Copy this file to .env and modify values as needed

# ARTIQ Master Connection Settings
ARTIQ_HTTP_HOST=127.0.0.1
ARTIQ_HTTP_PORT_NOTIFIERS=3250
ARTIQ_HTTP_PORT_CLIENTS=3251
ARTIQ_HTTP_PORT_BROADCAST=1067

# Logging
ARTIQ_HTTP_LOG_LEVEL=INFO

# ARTIQ Compatibility
ARTIQ_HTTP_OLD_ARTIQ_SUPPORT=false

# =============================================================================
# Authentication (required for public internet exposure)
# =============================================================================

# Your public HTTPS base URL (no trailing slash).
# This is the root of the domain Caddy is serving.
# The MCP endpoint will be at {EXTERNAL_BASE_URL}/mcp.
# Leave blank to run without auth (local network only).
EXTERNAL_BASE_URL=https://lab.example.com

# GitHub OAuth App credentials.
# Create one at: https://github.com/settings/developers
#   Application name:       ARTIQ HTTP
#   Homepage URL:           https://lab.example.com
#   Authorization callback URL: https://lab.example.com/github-callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=

# Service-to-service key (MCP server → backend, internal Docker network).
# Generate the same way as TOKEN_SECRET.
INTERNAL_API_KEY=

# Comma-separated GitHub usernames allowed to authenticate.
# Leave empty to allow any GitHub user (not recommended).
ALLOWED_GITHUB_USERS=your-github-username

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL=3600       # 1 hour
REFRESH_TOKEN_TTL=2592000   # 30 days

# Set to true to disable auth entirely (local dev only — never in production).
AUTH_DISABLED=false
