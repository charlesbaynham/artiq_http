# Uncomment to enable watchtower:
# COMPOSE_FILE=docker/compose.yml:docker/compose.watchtower.yml

# ARTIQ HTTP Configuration
# Copy this file to .env and modify values as needed

# ARTIQ Master Connection Settings
ARTIQ_HTTP_HOST=127.0.0.1
ARTIQ_HTTP_PORT_NOTIFIERS=3250
ARTIQ_HTTP_PORT_CLIENTS=3251
ARTIQ_HTTP_PORT_BROADCAST=1067

# Logging
ARTIQ_HTTP_LOG_LEVEL=INFO

# ARTIQ Compatibility
ARTIQ_HTTP_OLD_ARTIQ_SUPPORT=false

# Presets/favourites store (lab-wide, not ARTIQ-dependent). Uncomment to override
# the default of ~/.artiq_http/presets.json.
# ARTIQ_HTTP_PRESETS_FILE=~/.artiq_http/presets.json
